# Database (SQLite by default; use Postgres in docker-compose / production)
DATABASE_URL=sqlite:///./riseup.db
# DATABASE_URL=postgresql+psycopg://riseup:riseup@localhost:5432/riseup_db

# Optional Redis cache (in-memory cache is used when unset)
# REDIS_URL=redis://localhost:6379/0

# AI / LLM APIs (mock provider is used when a key is missing)
OPENAI_API_KEY=
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
OPENAI_MODEL=gpt-4o
# Per-feature provider routing: claude | openai | mock
LLM_ESCALATION_PROVIDER=claude
LLM_PARSE_PROVIDER=openai
LLM_PRIORITIZE_PROVIDER=claude
LLM_RECOMMEND_PROVIDER=claude
# Mock LLM behaviour for testing fallbacks: normal | invalid_json | error | disabled_method
MOCK_LLM_MODE=normal

# External integrations (mock adapters are used when unset)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ALEXA_API_KEY=
FIREBASE_API_KEY=
# Comma-separated channels the mock adapters should fail on (e.g. "call,alexa")
MOCK_TOOL_FAILURES=

# Application
DEBUG=False
SECRET_KEY=change-me
ENVIRONMENT=development
DEMO_TOKEN=dev-token
REQUIRE_AUTH=False
ENABLE_SCHEDULER=True
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Timing (seconds / minutes)
VERIFICATION_TIMEOUT_SECONDS=120
CHECKIN_RESPONSE_MINUTES=5
ESCALATION_RESPONSE_SECONDS=60
CAMERA_AVAILABLE=True
