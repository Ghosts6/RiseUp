# Safe example — contains no real credentials.
# Copy to .env and replace placeholders locally:
#   cp .env.example .env

# Database (H2 file by default; use Postgres in docker-compose / production)
DATABASE_URL=jdbc:h2:file:./data/riseup;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;DEFAULT_NULL_ORDERING=HIGH
DATABASE_USER=sa
DATABASE_PASSWORD=
DATABASE_DRIVER=org.h2.Driver
# DATABASE_URL=jdbc:postgresql://localhost:5432/riseup_db
# DATABASE_USER=riseup
# DATABASE_PASSWORD=riseup
# DATABASE_DRIVER=org.postgresql.Driver

# Optional Redis cache (in-memory cache is used when unset)
# REDIS_URL=redis://localhost:6379/0

# AI / LLM APIs (mock provider is used when a key is missing / still a placeholder)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
CLAUDE_API_KEY=YOUR_CLAUDE_API_KEY_HERE
CLAUDE_MODEL=claude-sonnet-4-5
OPENAI_MODEL=gpt-4o
# Per-feature provider routing: claude | openai | mock
LLM_ESCALATION_PROVIDER=claude
LLM_PARSE_PROVIDER=openai
LLM_PRIORITIZE_PROVIDER=claude
LLM_RECOMMEND_PROVIDER=claude
# Mock LLM behaviour for testing fallbacks: normal | invalid_json | error | disabled_method
MOCK_LLM_MODE=normal

# External integrations (mock adapters are used when unset / still a placeholder)
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID_HERE
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN_HERE
TWILIO_PHONE_NUMBER=YOUR_TWILIO_PHONE_NUMBER_HERE
ALEXA_API_KEY=YOUR_ALEXA_NOTIFYME_API_KEY_HERE
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY_HERE
# Optional SMTP for email reminder channel (mock/log when unset)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=riseup@example.com
# SMTP_USE_TLS=True
# Comma-separated channels the mock adapters should fail on (e.g. "call,alexa")
MOCK_TOOL_FAILURES=

# Application
DEBUG=False
SECRET_KEY=change-me
ENVIRONMENT=development
DEMO_TOKEN=dev-token
REQUIRE_AUTH=False
ENABLE_SCHEDULER=True
PUBLIC_BASE_URL=http://localhost:8000
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Timing (seconds / minutes)
VERIFICATION_TIMEOUT_SECONDS=120
CHECKIN_RESPONSE_MINUTES=5
# Spec F05: 30s after a failed call before the next escalation channel
ESCALATION_RESPONSE_SECONDS=30
REMINDER_RETRY_MINUTES=2
CAMERA_AVAILABLE=True
